# ============================================================
# LinkeePost — variables d'environnement
# Copier vers .env et remplir. NE JAMAIS commiter le .env.
# ============================================================

# --- Base de données (Postgres / Neon) ---
# Créer un projet sur https://neon.tech → copier la "connection string"
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Super admin ---
# Emails (séparés par des virgules) ayant accès à la vue Administration
ADMIN_EMAILS=

# --- Sécurité ---
# Secret de signature des sessions — générer avec : openssl rand -hex 32
AUTH_SECRET=
# Clé de chiffrement des tokens LinkedIn en base — générer avec : openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- API Claude (génération des posts) ---
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (génération des images de posts) ---
# https://platform.openai.com → API Keys (modèles « gpt-image » ; organisation vérifiée requise par OpenAI)
OPENAI_API_KEY=
# Modèles d'image essayés dans l'ordre (par défaut : gpt-image-2,gpt-image-1.5,gpt-image-1-mini,gpt-image-1). À ajuster quand OpenAI en retire ou en ajoute.
#OPENAI_IMAGE_MODELS=gpt-image-2,gpt-image-1.5
# Dossier de stockage des images générées (volume Docker en prod)
IMAGE_DIR=

# --- App LinkedIn n°1 : profil personnel ---
# https://www.linkedin.com/developers/apps — produits "Share on LinkedIn"
# + "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Doit être déclarée À L'IDENTIQUE dans l'onglet Auth de l'app
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
# Ajouter rw_events pour créer des événements LinkedIn depuis le module Événements
# (produit "Events Management API" accordé à cette app) : openid profile w_member_social rw_events
# Après changement : docker compose up -d --force-recreate app, puis reconnecter LinkedIn (onglet Profil).
LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_VERSION=202604

# --- App LinkedIn n°2 : pages entreprise (Community Management API) ---
LINKEDIN_ORG_CLIENT_ID=
LINKEDIN_ORG_CLIENT_SECRET=
LINKEDIN_ORG_REDIRECT_URI=http://localhost:3000/api/linkedin/callback-org
# Facultatif : sans cette variable, le code demande les permissions utiles (publication, administration, commentaires, abonnés pour la mention de personnes).
# Si vous la définissez, ajoutez-y r_organization_followers pour la recherche de personnes.
# LINKEDIN_MEMBER_SCOPES remplace les permissions demandées pour connecter le profil par l'application des pages (défaut : w_member_social r_basicprofile)
#LINKEDIN_MEMBER_SCOPES=w_member_social r_basicprofile
#LINKEDIN_ORG_SCOPES=w_organization_social rw_organization_admin r_organization_social_feed w_organization_social_feed r_organization_followers
# LINKEDIN_PEOPLE_SEARCH=0 désactive la recherche de personnes (et la demande de la permission des abonnés)

# --- App LinkedIn n°3 : statistiques du profil personnel (Community
# Management API, app dédiée) ---
# Un produit LinkedIn "Community Management API" doit être seul sur son app
# (incompatible avec "Share on LinkedIn" / "Sign In with LinkedIn", déjà sur
# l'app n°1) : c'est pour ça qu'il faut une app à part. Distincte de l'app
# n°2 (pages entreprise) pour ne pas lier les stats perso à cette connexion.
LINKEDIN_STATS_CLIENT_ID=
LINKEDIN_STATS_CLIENT_SECRET=
LINKEDIN_STATS_REDIRECT_URI=http://localhost:3000/api/linkedin/callback-stats
LINKEDIN_STATS_SCOPES=r_member_postAnalytics

# --- URL publique de l'app ---
# En prod : https://postgenius.votredomaine.fr (penser à mettre à jour
# les redirect URIs LinkedIn en conséquence)
APP_URL=http://localhost:3000

# --- Email ---
# Utilisé pour : mot de passe oublié, invitations d'équipe, liens de validation client, notifications à l'agence, fin d'essai.
# Sans SMTP_HOST (dev), aucun e-mail ne part : les liens restent copiables dans l'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LinkeePost <no-reply@votredomaine.fr>"
# Boîte de contact : reçoit le formulaire de contact et sert d'adresse de réponse aux e-mails envoyés (défaut : contact@postgenius.network)
CONTACT_EMAIL=

# --- Notifications push (rappels jour-J événement) ---
# Générer une paire :  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BFghOHm7Y6yV216eGFc6u_EDAT6lD5Z3BKXMz3qVSnsWgFhLgTYjD6RPPxj6DPNQjFFGmr19iPNw_DhEgFhkvyY
VAPID_PRIVATE_KEY=Qkl0yR-6zCdqq8JzJLbVK4EELeqPcYf1XtastVMqLEY
VAPID_SUBJECT=mailto:contact@postgenius.network

# --- Programmation des posts ---
# Le planificateur intégré (serveur Node persistant) publie chaque minute.
# CRON_SECRET ne sert que si une plateforme serverless appelle /api/cron/publish-due
CRON_SECRET=
DISABLE_LOCAL_SCHEDULER=

# --- Mesure d'audience (Umami : sans cookie, sans bandeau de consentement) ---
# Chargée seulement sur les pages publiques. Par défaut : Umami Cloud, site postgenius.network (UMAMI_DISABLED=1 pour couper).
# UMAMI_SCRIPT_URL : https://cloud.umami.is/script.js (Umami Cloud) ou https://stats.postgenius.network/script.js (auto-hébergé, voir DEPLOY.md)
# UMAMI_WEBSITE_ID : identifiant du site affiché dans Umami (Paramètres > Sites > Modifier)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
# Auto-hébergement (profil « stats » de docker-compose.yml) : COMPOSE_PROFILES=stats
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# --- Vidéo et audio de « Seconde vie d'un contenu » (tous facultatifs ; ffmpeg est installé dans l'image Docker) ---
# MEDIA_MAX_MB=200            taille maximale d'un fichier envoyé
# MEDIA_MAX_MINUTES=60        durée maximale d'un enregistrement
# MEDIA_CONCURRENCY=2         transcriptions traitées en même temps sur le serveur
# MEDIA_TMP_DIR=              dossier de travail temporaire (par défaut : dossier temporaire du système)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe   modèle de transcription (déjà utilisé par la dictée vocale)

# --- Garde-fous de déploiement (facultatifs mais recommandés : voir DEPLOY.md, section 12) ---
# Copie instantanée de la base Neon avant chaque changement de schéma (clé : console.neon.tech → Account settings → API keys)
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_KEEP_BRANCHES=5     garde les 5 dernières copies « avant-deploy-… », supprime les plus anciennes
# Contrôle automatique après déploiement (retour arrière automatique s'il échoue)
# SMOKE_URL=https://postgenius.network   adresse contrôlée (à changer si le serveur ne joint pas sa propre adresse publique)
# SMOKE_EMAIL=            compte de contrôle (un compte ordinaire, jamais administrateur) : teste la vraie connexion
# SMOKE_PASSWORD=
