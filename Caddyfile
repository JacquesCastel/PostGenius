# HTTPS automatique (Let's Encrypt) — linkeepost.app
linkeepost.app {
	reverse_proxy app:3000
}

# Redirection www → apex
www.linkeepost.app {
	redir https://linkeepost.app{uri} permanent
}

# Ancien domaine → nouveau domaine (301, conserve le chemin)
postgenius.network, www.postgenius.network {
	redir https://linkeepost.app{uri} permanent
}
