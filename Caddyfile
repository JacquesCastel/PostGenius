# HTTPS automatique (Let's Encrypt).
#
# Le site est servi sur vercea.app (domaine du produit) ; postgenius.network (ancien domaine de production) redirige les PAGES vers vercea.app.
# linkeepost.app ne pointe pas vers ce serveur (DNS chez le registraire) : aucun bloc, aucun certificat possible ici.
# Ce fichier ne doit jamais rediriger un domaine vers un domaine que le serveur ne sert pas (test : scripts/caddyfile.test.mjs).
#
# APPLIQUER UN CHANGEMENT : le fichier est monté comme fichier unique, un `git pull` ne suffit pas (voir DEPLOY.md) :
#   docker compose run --rm --no-deps -v "$PWD/Caddyfile:/etc/caddy/Caddyfile:ro" caddy caddy validate --config /etc/caddy/Caddyfile
#   docker compose up -d --force-recreate caddy

# Domaine du produit
vercea.app {
	reverse_proxy app:3000
}
www.vercea.app {
	redir https://vercea.app{uri} permanent
}

# Ancien domaine : 301 vers le même chemin sur vercea.app, POUR LES PAGES SEULEMENT (GET, HEAD).
# Restent servis directement, sans redirection :
#   - /api/*  : retours OAuth (LinkedIn, Instagram), webhooks (Stripe), serveur MCP, désinscription : une 301 les casserait ;
#   - /oauth/* et /.well-known/* : assistants IA déjà branchés sur l'ancienne adresse ;
#   - toute requête qui n'est pas un GET ou un HEAD (POST, PUT…).
# /privacy-policy et /privacy sont redirigées depuis que la déclaration chez LinkedIn (et Meta) pointe vers https://vercea.app/privacy-policy.
postgenius.network, www.postgenius.network {
	@pages {
		method GET HEAD
		not path /api/* /oauth/* /.well-known/*
	}
	redir @pages https://vercea.app{uri} permanent
	reverse_proxy app:3000
}
