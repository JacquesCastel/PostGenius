# HTTPS automatique (Let's Encrypt).
#
# ÉTAT RÉEL DU SERVEUR (relevé le 26 novembre 2026) : le site est servi sur postgenius.network ; linkeepost.app ne pointe PAS vers ce serveur
# (son DNS est chez le registraire) : aucun certificat n'est possible pour lui ici, donc aucun bloc.
# Ce fichier ne doit jamais rediriger un domaine vers un domaine que le serveur ne sert pas (test : scripts/caddyfile.test.mjs).

# Domaine actuel de production
postgenius.network {
	reverse_proxy app:3000
}
www.postgenius.network {
	redir https://postgenius.network{uri} permanent
}

# Nouveau domaine, servi EN PARALLÈLE, sans aucune redirection entre les deux (étape 2 de docs/site/migration-domaine-301.md).
# Le certificat est obtenu dès que le DNS de vercea.app pointe vers ce serveur ; d'ici là, Caddy réessaie sans gêner les autres domaines.
vercea.app {
	reverse_proxy app:3000
}
www.vercea.app {
	redir https://vercea.app{uri} permanent
}
