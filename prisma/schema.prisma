generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev (macOS), debian-openssl-3.0.x pour le runtime Docker (node:22-slim)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Contenu éditable du site (landing) — une seule entrée, key = "landing".
// value = JSON sérialisé { hero, plans, faq, ... } édité depuis l'admin.
model SiteContent {
  key       String   @id // "landing"
  value     String // JSON
  updatedAt DateTime @updatedAt
}

// Demandes envoyées via le formulaire de contact public.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  handled   Boolean  @default(false) // marqué comme traité par un admin
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Articles de blog (SEO) — gérés depuis l'admin.
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String? // résumé (meta description + carte)
  content     String // corps en Markdown
  coverImage  String? // URL d'image de couverture
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id        String           @id @default(cuid())
  email     String           @unique
  password  String // hash bcrypt
  name      String?
  createdAt DateTime         @default(now())
  role     String  @default("user") // user | admin
  disabled Boolean @default(false) // compte suspendu par un admin

  // --- Offre / abonnement ---
  plan          String    @default("pro") // essentiel | pro | agence
  trialEndsAt   DateTime? // fin de la période d'essai (14 j)
  planUpdatedAt DateTime? // dernière modification du plan

  // --- Abonnement Stripe ---
  stripeCustomerId     String?   @unique // identifiant client Stripe
  stripeSubscriptionId String?   // identifiant de l'abonnement en cours
  subscriptionStatus   String?   // active | trialing | past_due | canceled | ...
  subscriptionInterval String?   // month | year
  currentPeriodEnd     DateTime? // fin de la période payée en cours
  cancelAtPeriodEnd    Boolean   @default(false) // résiliation programmée : l'abonnement s'arrête à la fin de la période payée
  // Changement d'offre programmé (descente à l'échéance) : l'offre et la périodicité qui suivront, et la date d'effet
  scheduledPlan        String?
  scheduledInterval    String?
  scheduledAt          DateTime?

  linkedin  LinkedInAccount?
  instagram InstagramAccount?
  drafts    Draft[]
  resetTokens PasswordResetToken[]
  campaigns Campaign[]
  sources   ContentSource[]
  usage     UsageEvent[]
  events    Event[]
  pushSubs  PushSubscription[]
  lifecycleEmails LifecycleEmail[]
  interactions    InteractionLog[]
  knowledge       KnowledgeSource[]
  stylePosts      StylePost[]
  copilotMessages CopilotMessage[]

  // --- Profil de rédaction ---
  headline        String? // titre pro, ex : "Consultant SEO @ Acme"
  expertise       String? // "Je suis un(e)..." — pré-rempli dans le générateur
  themes          String? // thématiques favorites, séparées par des virgules
  tone            String? // ton par défaut (Professionnel, Inspirant, ...)
  postLanguage    String  @default("fr") // langue de génération des posts (fr, en, es, de, it, pt, nl)
  styleExamples   String? // JSON : 3 posts types de l'auteur (import de ses anciens posts), servent d'exemples de voix
  styleImportedAt DateTime? // date du dernier import d'anciens posts
  styleNotes      String? // consignes libres : tutoiement, emojis, longueur de phrases...
  defaultMaxChars Int? // longueur par défaut des posts
  onboardedAt     DateTime? // null = doit passer par l'onboarding en étapes

  // --- Contexte métier & communication (outil de campagne) ---
  website             String? // site internet de la marque (analysé par l'IA pour nourrir le profil)
  companyName         String? // nom de l'entreprise ou de la marque personnelle
  editorialLine       String? // ligne éditoriale de l'entreprise principale (angle, registre, sujets à privilégier ou éviter)
  brandVoice          String? // voix de la marque sur sa page entreprise (« nous », vocabulaire, ce qu'on évite) — distincte de la voix de la personne
  businessDescription String? // activité, produits/services, proposition de valeur
  targetAudience      String? // audience cible sur LinkedIn
  market              String? // marché, concurrence, positionnement
  commGoals           String? // objectifs de communication (CSV)

  // --- Rythme de publication ---
  postsPerWeek      Int? // déduit des jours choisis
  publishDays       String? // jours préférés, CSV "1,3,5" (1 = lundi)
  publishTime       String? // heure de publication "09:00"
  requireValidation Boolean @default(true) // valider les posts de série avant publication
  autoGenerate      Boolean @default(false) // pilote auto : générer chaque semaine les posts des créneaux à venir

  // Publication autonome depuis le copilote éditorial — opt-in, désactivé par
  // défaut (null). Si renseigné (0-100), les recommandations dont la
  // confiance atteint ce seuil sont programmées SANS validation manuelle
  // (lib/editorial/autopilot.js). Ne change rien pour les comptes qui ne
  // l'activent pas explicitement — y compris les clients gérés par l'agence.
  autoPublishThreshold Int?

  // Note libre pour le copilote éditorial — renseignée depuis la zone de
  // prompt du tableau de bord ("Que publier aujourd'hui ?") pour affiner
  // les propositions du jour. Persistée comme le reste du profil : elle
  // alimente aussi bien la génération de posts (userContextBlock) que le
  // moteur de recommandations (lib/editorial/recommendations.js).
  editorialNote String?

  // --- Multi-compte Agence ---
  // Si managedByUserId est renseigné, ce compte est un client géré par une agence.
  // Le client n'a pas de mot de passe utilisable et n'accède jamais à l'outil.
  managedByUserId String?
  managedBy       User?   @relation("AgencyClients", fields: [managedByUserId], references: [id], onDelete: SetNull)
  clients         User[]  @relation("AgencyClients")

  // --- Plusieurs entreprises pour une même personne ---
  // L'entreprise « principale » reste portée par les champs ci-dessus ; les autres sont des Context.
  contexts Context[]

  // --- Charte graphique ---
  brandKits      BrandKit[]
  mediaAssets    MediaAsset[]
  slideTemplates SlideTemplate[]

  // --- Copilote éditorial ---
  editorialPillars   EditorialPillar[]
  postRemarks        PostRemark[]
  remarkSuggestions  RemarkSuggestion[]
  languageElements   LanguageElement[]
  languageProposals  LanguageProposal[]
  remarkAnalysisAt   DateTime? // dernière analyse des modifications de posts (suggestions de remarques)
  editorialRecos     EditorialRecommendation[]
}

// Charte graphique : couleurs, logo, police, style de fond
// Utilisée par le moteur Satori pour générer les visuels des posts et carrousels.
model BrandKit {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Charte de l'entreprise (nul = entreprise principale). Une charte par (compte, entreprise), garantie par le code.
  contextId      String?
  context        Context? @relation(fields: [contextId], references: [id], onDelete: Cascade)

  // Couleurs
  primaryColor   String   @default("#0a66c2") // fond principal
  secondaryColor String   @default("#ffffff") // texte / éléments clairs
  accentColor    String   @default("#ff5a5f") // accents, barres, séparateurs

  // Logo (fichier stocké dans ./data/logos/, URL servie par /api/images/logos/:file)
  logoUrl        String?

  // Typographie
  fontFamily     String   @default("Inter") // Inter | Poppins | Montserrat | Raleway

  // Style de fond des visuels
  bgStyle        String   @default("solid") // solid | gradient

  // Image de fond personnalisée (fichier dans ./data/backgrounds/, URL /api/images/backgrounds/:file)
  backgroundUrl  String?

  // Tagline optionnelle affichée en bas des visuels
  tagline        String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Modèle personnalisé d'une slide de carrousel (éditeur visuel dans Charte graphique) :
// éléments texte/image positionnés librement, qui remplacent la mise en page fixe de
// lib/templates.js pour ce type de slide. "data" est un JSON { elements: [...] } —
// voir le commentaire de renderCustomSlide dans lib/templates.js pour la forme exacte.
// Un seul modèle par type et par utilisateur : l'enregistrer remplace le précédent.
model SlideTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "title" | "content" | "end"
  data      String // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
}

// Médiathèque : images uploadées, générées par IA, ou transformées (recadrage, filtres, texte)
// Catégories : background | generated | logo | asset
// Stockées dans ./data/media/, servies par /api/images/media/:file
model MediaAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  category  String   @default("asset") // background | generated | asset | logo
  fileName  String   // fichier sur disque (data/media/)
  url       String   // URL publique /api/images/media/:fileName
  width     Int?
  height    Int?
  mimeType  String   @default("image/png")
  sizeBytes Int?
  prompt    String?  // prompt IA utilisé pour la generation (ou null)

  createdAt DateTime @default(now())

  @@index([userId, category])
}

// Tokens LinkedIn du client (app perso + app pages entreprise)
model LinkedInAccount {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personToken     String?
  personSub       String?
  personName      String?
  personExpiresAt DateTime?
  personScope     String? // permissions accordées par LinkedIn à la dernière connexion (champ « scope » du jeton)
  orgToken        String?
  orgExpiresAt    DateTime?
  orgUrn          String?   // urn:li:organization:ID de la première page (compat)
  orgName         String?   // nom de la première page (compat)
  orgAccounts     String?   // JSON : [{urn, name}, ...] — toutes les pages admin
  statsToken      String?   // app dédiée "PostGenius Stats" (Community Management API,
  statsExpiresAt  DateTime? // seule permission possible pour r_member_postAnalytics)
}

// Compte Instagram Business/Creator connecté (via Instagram Login)
// igToken = Instagram User Access Token long-lived (~60 j, renouvelable)
model InstagramAccount {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  igUserId    String    // Instagram User ID (renvoyé par l'échange de code)
  igUsername  String?   // @username Instagram
  igName      String?   // nom affiché
  igPicture   String?   // URL de la photo de profil
  pageId      String?   // obsolète (Facebook Login) — nullable depuis Instagram Login
  pageToken   String    // Instagram User Access Token chiffré (AES-256-GCM)
  expiresAt   DateTime? // expiration du long-lived token (~60 j)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Jetons de réinitialisation de mot de passe (hash SHA-256, usage unique, 1 h)
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// Emails de cycle de vie déjà envoyés (bienvenue, fin d'essai, paiement échoué).
// La contrainte unique (userId, key) garantit qu'un même email n'est jamais
// envoyé deux fois, même si le planificateur repasse ou que Stripe rejoue un webhook.
// key = "welcome" | "trial_ending" | "payment_failed:<id facture Stripe>"
model LifecycleEmail {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  sentAt DateTime @default(now())

  @@unique([userId, key])
}

// Consommation IA de la plateforme (tokens Claude, images OpenAI)
model UsageEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String   @default("claude") // claude | image
  context      String? // post, série, variantes, retouche, campagne, cadrage, sources, image...
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  images       Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// Source de veille : site/flux RSS en affinité avec le profil du client
model ContentSource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String // URL du flux RSS (ou de la page si flux découvert)
  title     String
  createdAt DateTime @default(now())
  // Entreprise dont la veille suit ce flux (nul = entreprise principale)
  contextId String?
  context   Context? @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
}

// Campagne LinkedIn : un thème + un brief qui contextualisent la génération
model Campaign {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  theme     String // thème principal de la campagne
  objective String? // objectif spécifique (leads, notoriété...)
  context   String? // brief enrichi : réponses aux questions IA + exemple validé
  brief     String? // JSON : brief structuré importé d'un document (voix par compte, règles, ressources, calendrier) — lib/campaignBrief.js
  mood      String? // humeur éditoriale des posts de la campagne (lib/moods.js), null = aucune
  status    String   @default("active") // active | archivée
  createdAt DateTime @default(now())
  drafts    Draft[]
  // Entreprise pour laquelle la campagne est menée (nul = entreprise principale)
  contextId String?
  company   Context? @relation(fields: [contextId], references: [id], onDelete: SetNull)
}

model Draft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // simple | carrousel | video
  theme     String
  expertise String
  tone      String
  maxChars  Int
  text      String
  // Texte tel que produit par l'IA, avant les modifications de l'utilisateur : sert à repérer
  // ses habitudes d'édition (suggestions de remarques). Absent des anciens brouillons.
  generatedText String?
  extra     String? // JSON (plan carrousel / script vidéo)
  status    String   @default("brouillon") // brouillon | programmé | publié | erreur
  postId    String? // x-restli-id LinkedIn après publication
  createdAt DateTime @default(now())

  // --- Programmation ---
  scheduledAt  DateTime? // date/heure de publication automatique
  publishedAt  DateTime? // date de publication effective
  target       String    @default("person") // "person" ou "urn:li:organization:ID"
  publishError String? // message d'erreur si la publication automatique a échoué
  auto         Boolean   @default(false) // généré par le moteur de campagne

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Entreprise pour laquelle le post a été écrit (nul = entreprise principale)
  contextId String?
  context   Context? @relation(fields: [contextId], references: [id], onDelete: SetNull)

  // Pilier éditorial (copilote) — nullable : posts existants non rétroactivement classés
  pillarId String?
  pillar   EditorialPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)

  // Recommandation éditoriale à l'origine de ce post, si généré depuis "Que publier ?"
  editorialReco EditorialRecommendation?

  inspirationUrl String? // article de veille sur lequel le post s'appuie

  imageUrl    String? // image générée pour le post (/api/images/...)
  imagePrompt String? // prompt utilisé pour générer l'image
  videoUrl    String? // vidéo du post, fichier envoyé par le client (/api/videos/...) — remplace l'image à la publication
  youtubeUrl  String? // lien YouTube joint au post (carte cliquable sur LinkedIn) — remplace l'image, cède la place à videoUrl

  // --- Instagram ---
  igPostId  String? // media ID Instagram après publication
  igStatus  String? // published | error

  performance PostPerformance[]
}

// Instantané des vraies statistiques LinkedIn d'un post publié (page entreprise
// uniquement — les stats du profil personnel dépendent d'une permission LinkedIn
// encore en attente de revue). Capturé par lib/editorial/performance.js à des
// paliers fixes après publication : la mémoire d'historique qui manquait pour un
// jour relier les recommandations à de vrais résultats plutôt qu'au seul
// accepté/ignoré (voir lib/editorial/learning.js).
model PostPerformance {
  id          String   @id @default(cuid())
  draftId     String
  draft       Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  offsetHours Int // palier après publication : 24 (J+1) ou 168 (J+7)
  capturedAt  DateTime @default(now())
  impressions Int?
  likes       Int?
  comments    Int?
  shares      Int?
  clicks      Int?

  @@unique([draftId, offsetHours])
}

// Événement (salon, forum…) auquel le client participe : sert à générer
// des posts de rappel sur les jours qui encadrent l'événement.
model Event {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // nom du salon / forum
  location  String? // lieu, ville, n° de stand
  url       String? // lien de l'événement
  imageUrl  String? // image du salon (récupérée depuis le lien)
  details   String? // description récupérée depuis le lien (contexte pour l'IA)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  remindedAt DateTime? // dernière notification jour-J envoyée (évite les doublons)

  // Événement LinkedIn créé depuis LinkeePost (API Events Management, permission rw_events)
  linkedinEventId   String? // identifiant LinkedIn (chaîne : dépasse la précision d'un nombre JavaScript)
  linkedinPostUrn   String? // post qui rend l'événement visible ; le supprimer supprime l'événement
  linkedinEventType String? // online | inPerson (non modifiable après création)
  linkedinOrganizer String? // urn:li:person:… ou urn:li:organization:…
  linkedinAt        DateTime? // création sur LinkedIn

  drafts Draft[]

  @@index([userId, startDate])
}

// Abonnement Web Push (notifications) d'un appareil du client
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Pilier éditorial (ligne éditoriale) : catégorie de contenu personnalisable
// utilisée pour équilibrer les recommandations (ex. Expertise, Cas client...).
// Semée avec des valeurs par défaut au premier usage (lib/editorial/pillars.js).
model EditorialPillar {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean  @default(false) // seedé automatiquement vs créé par l'utilisateur/l'IA
  order       Int      @default(0) // rang d'importance manuel (0 = le plus important) — piloté depuis Copilote IA
  createdAt   DateTime @default(now())

  drafts          Draft[]
  recommendations EditorialRecommendation[]

  @@unique([userId, name])
}

// Recommandation éditoriale ("Que publier ?") générée par le copilote —
// voir lib/editorial/recommendations.js. Le statut fait office de journal de
// feedback (proposée → générée/planifiée, ou ignorée/rejetée) : pas de table
// séparée pour rester simple (cf. respondedAt pour l'horodatage de la réponse).
model EditorialRecommendation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  topic      String // sujet proposé
  angle      String // angle éditorial
  rationale  String // pourquoi c'est pertinent maintenant (affiché à l'utilisateur)
  objective  String? // objectif (notoriété, leads, expertise...)
  audience   String? // audience visée, si différente de l'audience par défaut
  postType   String   @default("simple") // simple | carrousel | video
  hook       String? // accroche suggérée
  cta        String? // appel à l'action suggéré
  priority   Int      @default(50) // 0-100, ordre d'affichage
  confidence Int      @default(50) // 0-100, confiance du moteur

  pillarId String?
  pillar   EditorialPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)

  status     String    @default("proposée") // proposée | générée | planifiée | ignorée | rejetée | remplacée (régénération auto, neutre pour l'apprentissage)
  respondedAt DateTime? // horodatage du feedback utilisateur

  draftId String? @unique
  draft   Draft?  @relation(fields: [draftId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, status, createdAt])
}

// Remarques de l'utilisateur pour ses futurs posts ("trop long", "moins d'émojis"…),
// saisies sous un post généré ou depuis Profil. Liste visible et supprimable
// (10 maximum) : injectée dans les prompts de génération (post manuel, pilote
// automatique, réécriture) en plus des consignes de style du profil.
model PostRemark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Suggestion de remarque déduite des modifications que l'utilisateur apporte aux posts
// générés ("vous retirez souvent les émojis"). Jamais appliquée seule : l'utilisateur
// l'accepte (elle devient une PostRemark) ou l'ignore.
model RemarkSuggestion {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String // la remarque proposée
  key         String    @default("llm") // motif (emojis | length | hashtags | question | llm) : un motif refusé n'est pas reproposé
  evidence    String // ce qui a été observé, en une phrase
  quote       String? // phrase citée par le modèle (motifs de fond) : sert à ne pas reproposer le même motif reformulé
  status      String    @default("proposée") // proposée | acceptée | ignorée
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([userId, status])
}

// Journal des commentaires et réactions ENVOYÉS depuis LinkeePost (écran Interagir,
// commentaires sous un de ses posts). LinkedIn ne permet pas de les relire pour un profil
// personnel : ce journal est la seule trace, affichée dans Statistiques.
model InteractionLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String // comment | react
  urn          String // post concerné (urn:li:activity|share|ugcPost:…)
  reactionType String? // LIKE, PRAISE… (action = react)
  text         String? // commentaire envoyé (tronqué à 300 caractères)
  draftId      String? // brouillon correspondant si c'est un post publié via LinkeePost
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, draftId])
}

// Invitation de test envoyée par un admin : le lien donne un accès gratuit (offre et durée fixes,
// voir lib/invites.js) à la personne qui crée son compte avec l'adresse invitée.
model Invitation {
  id             String    @id @default(cuid())
  email          String // adresse invitée (minuscules) : le compte doit être créé avec elle
  token          String    @unique // secret du lien d'invitation
  note           String? // mot libre de l'admin (visible dans la liste uniquement)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime // fin de validité du lien
  lastSentAt     DateTime? // dernier envoi de l'e-mail
  invitedBy      String? // id de l'admin
  revokedAt      DateTime?
  acceptedAt     DateTime?
  acceptedUserId String?

  @@index([email])
}

// Base de connaissances d'un client : textes, articles (liens) et documents qu'il fournit pour que les posts
// collent à son contexte et à ses faits. Chaque source est résumée par l'IA ; seuls ces résumés et les faits
// relevés (chiffres, cas, positions) servent à rédiger, jamais sans que la source soit citée.
// Anciens posts de l'auteur (import de son style) : le plus proche du sujet sert d'exemple de voix
// Historique de la discussion avec le copilote éditorial (conservé d'une visite à l'autre). Le modèle
// la relit à chaque échange pour apprendre les goûts du client ; les consignes durables qui s'en
// dégagent passent par RemarkSuggestion (jamais appliquées sans son accord).
model CopilotMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  recoId    String? // piste concernée, sans relation : elle peut être ignorée ou remplacée ensuite
  recoTopic String? // intitulé de la piste au moment de l'échange (affichage)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model StylePost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Entreprise supplémentaire d'une personne qui travaille pour plusieurs entreprises avec un seul compte LinkedIn.
// La voix de la personne reste la sienne ; ce qui change d'un post à l'autre, c'est le contexte : activité, cible,
// positionnement, objectifs, voix de la marque, rôle, thèmes et ligne éditoriale. Les champs de User décrivent
// l'entreprise principale (contextId nul partout).
model Context {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String // nom de l'entreprise
  role                String? // rôle ou titre de la personne dans cette entreprise
  website             String?
  businessDescription String?
  targetAudience      String?
  market              String?
  commGoals           String? // CSV
  brandVoice          String?
  themes              String? // thématiques, séparées par des virgules
  editorialLine       String? // angle et registre éditorial propres à cette entreprise
  createdAt           DateTime @default(now())

  sources   KnowledgeSource[]
  languageElements  LanguageElement[]
  languageProposals LanguageProposal[]
  drafts    Draft[]
  campaigns Campaign[]
  brandKits BrandKit[]
  feeds     ContentSource[]

  @@index([userId])
}

model KnowledgeSource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // note | link | file | posts
  title     String
  origin    String? // adresse du lien ou nom du fichier
  text      String // texte extrait (borné)
  summary   String? // résumé produit par l'IA
  facts     String? // JSON : faits et preuves relevés dans le texte (chaque chiffre vérifié dans la source)
  embedding Json? // vecteur sémantique (résumé, thèmes, faits) pour la recherche par sens ; recalculé quand la lecture change
  insights  String? // JSON : lecture éditoriale { themes[], vocabulary[], positions[] } (vocabulaire vérifié dans la source)
  pinned    Boolean  @default(false) // « toujours utiliser » (ex. présentation de l'entreprise)
  // Entreprise à laquelle la source appartient (nul = entreprise principale). Une source « partagée » sert pour toutes.
  contextId String?
  context   Context? @relation(fields: [contextId], references: [id], onDelete: Cascade)
  shared    Boolean  @default(false)
  charCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Éléments de langage validés par l'auteur : mots à privilégier, mots à éviter, formulations types.
// Propres à une entreprise (contextId nul = entreprise principale) ; injectés dans chaque rédaction.
model LanguageElement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextId String?
  context   Context? @relation(fields: [contextId], references: [id], onDelete: Cascade)
  kind      String // use | avoid | phrase
  text      String
  createdAt DateTime @default(now())

  @@index([userId, contextId])
}

// Proposition de l'IA après lecture du datalake, à valider : jamais appliquée seule.
// Une proposition ignorée n'est jamais reproposée.
model LanguageProposal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextId   String?
  context     Context?  @relation(fields: [contextId], references: [id], onDelete: Cascade)
  kind        String // phrase | use | avoid | line | pillar
  text        String
  detail      String? // pilier : sa description ; autres : pourquoi, en une phrase
  origin      String? // titre de la source d'où vient la proposition
  status      String    @default("proposée") // proposée | acceptée | ignorée
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([userId, contextId, status])
}
